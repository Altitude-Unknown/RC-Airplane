diff --git a/libraries/APM_Control/AP_RollController.cpp b/libraries/APM_Control/AP_RollController.cpp
index 04ba21cfe5..0fed1f98ef 100644
--- a/libraries/APM_Control/AP_RollController.cpp
+++ b/libraries/APM_Control/AP_RollController.cpp
@@ -172,8 +172,11 @@ float AP_RollController::get_airspeed() const
 {
     float aspeed;
     if (!AP::ahrs().airspeed_EAS(aspeed)) {
-        // If no airspeed available use 0
-        aspeed = 0.0;
+        // If no airspeed available use the average of min and max, as the
+        // pitch controller does. Using 0 made is_underspeed() always true on
+        // aircraft with neither an airspeed sensor nor GPS, which locked the
+        // roll integrator at zero for the whole flight.
+        aspeed = 0.5f*(float(aparm.airspeed_min) + float(aparm.airspeed_max));
     }
     return aspeed;
 }
diff --git a/libraries/AP_AHRS/AP_AHRS_DCM.cpp b/libraries/AP_AHRS/AP_AHRS_DCM.cpp
index 23c2b29289..3331c34ba8 100644
--- a/libraries/AP_AHRS/AP_AHRS_DCM.cpp
+++ b/libraries/AP_AHRS/AP_AHRS_DCM.cpp
@@ -729,11 +729,31 @@ AP_AHRS_DCM::drift_correction(float deltat)
         }
 
         float airspeed_TAS = _last_airspeed_TAS;
+        bool have_airspeed_sensor = false;
 #if AP_AIRSPEED_ENABLED
         if (airspeed_sensor_enabled()) {
             airspeed_TAS = AP::airspeed()->get_airspeed() * get_EAS2TAS();
+            have_airspeed_sensor = true;
         }
 #endif
+#ifdef AP_AHRS_DCM_NO_GPS_ASSUMED_TAS
+        // With neither GPS nor an airspeed sensor the velocity used for
+        // the centripetal correction is zero, so in a steady turn the
+        // estimator slowly accepts the bank as level. While armed, assume
+        // a forward airspeed so turning accelerations are compensated.
+        const bool assume_tas = fly_forward && !have_airspeed_sensor &&
+                                hal.util->get_soft_armed();
+        if (assume_tas) {
+            airspeed_TAS = AP_AHRS_DCM_NO_GPS_ASSUMED_TAS;
+        }
+        if (assume_tas != _assumed_tas_active) {
+            // avoid a false acceleration step when the assumption starts or stops
+            _assumed_tas_active = assume_tas;
+            _last_velocity = _dcm_matrix.colx() * airspeed_TAS + _wind;
+        }
+#else
+        (void)have_airspeed_sensor;
+#endif
 
         // use airspeed to estimate our ground velocity in
         // earth frame by subtracting the wind
