# BOREALIS Arduplane-FC v92, STM32H743VIT6. Local bench bring-up.
# Private experimental ID, not an upstream board-ID allocation.
MCU STM32H7xx STM32H743xx
APJ_BOARD_ID 65092
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PC10 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1

PA4 BARO_CS CS
PD4 ACCEL_CS CS
PD5 GYRO_CS CS
PC11 BUZZER_OFF OUTPUT LOW

# Keep servo signals inactive during initial bring-up.
PE14 THROTTLE INPUT PULLDOWN
PE13 AILERON INPUT PULLDOWN
PE11 ELEVATOR INPUT PULLDOWN
PE9 RUDDER INPUT PULLDOWN
PD12 AUX1 INPUT PULLDOWN
PD13 AUX2 INPUT PULLDOWN
