# BOREALIS Arduplane-FC v92: USB/sensor diagnostic firmware, NOT flight ready.
# Source: Arduplane-FC v92.pdf. IMU orientation remains unverified.
# Private experimental ID, not an upstream board-ID allocation.
MCU STM32H7xx STM32H743xx
APJ_BOARD_ID 65092
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

SERIAL_ORDER OTG1 USART1 USART6
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# JP2 GPS UART and J5 share USART1 on this schematic.
PB6 USART1_TX USART1
PB7 USART1_RX USART1
PC6 USART6_TX USART6
PC7 USART6_RX USART6
define DEFAULT_SERIAL1_PROTOCOL 0
define DEFAULT_SERIAL2_PROTOCOL 0

# Sensor buses: PC2/PC3 refer to the PC2_C/PC3_C package pins.
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 BARO_CS CS
PD3 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2
PD4 ACCEL_CS CS
PD5 GYRO_CS CS
SPIDEV ms5611 SPI1 DEVID1 BARO_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmi088_a SPI2 DEVID1 ACCEL_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmi088_g SPI2 DEVID2 GYRO_CS MODE3 1*MHZ 10*MHZ
IMU BMI088 SPI:bmi088_a SPI:bmi088_g ROTATION_NONE
BARO MS5611 SPI:ms5611

I2C_ORDER I2C1
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

# Active-high status LED L3. Other health LEDs stay off for now.
PC10 LED OUTPUT LOW GPIO(90)
define AP_NOTIFY_GPIO_LED_1_ENABLED 1
define AP_NOTIFY_GPIO_LED_1_PIN 90
define HAL_GPIO_LED_ON 1
PB15 IMU_LED OUTPUT LOW
PB14 BARO_LED OUTPUT LOW
PB13 GPS_LED OUTPUT LOW
PB12 MAG_LED OUTPUT LOW
PC11 BUZZER_OFF OUTPUT LOW
PA15 ARMING_BUTTON INPUT PULLUP

# No PWM output or arming-button function in this diagnostic target.
PE14 THROTTLE INPUT PULLDOWN
PE13 AILERON INPUT PULLDOWN
PE11 ELEVATOR INPUT PULLDOWN
PE9 RUDDER INPUT PULLDOWN
PD12 AUX1 INPUT PULLDOWN
PD13 AUX2 INPUT PULLDOWN

# Keep normal missing-sensor checks and the resulting MAVLink error loop.
# No fake IMU/barometer and no arming-check overrides.
define HAL_OS_FATFS_IO 0
# No external ADC inputs are assigned on v92.
define HAL_USE_ADC FALSE
