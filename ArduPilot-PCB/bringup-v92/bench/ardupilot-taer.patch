+#if defined(HAL_BOREALIS_RC_BENCH_TEST)
+extern const AP_HAL::HAL& hal;
+bool borealis_rc_bench_set(bool enable);
+static bool borealis_rc_active;
+static bool borealis_rc_stopping;
+static bool borealis_rc_has_run;
+static uint32_t borealis_rc_started_ms;
+static uint32_t borealis_rc_stop_ms;
+static uint32_t borealis_rc_last_frame_ms;
+static uint32_t borealis_rc_low_since_ms;
+static uint32_t borealis_rc_last_usb_ms;
+
+static bool borealis_rc_inputs_valid()
+{
+    if (hal.rcin->num_channels() < 4 || AP::RC().failsafe_active()) {
+        return false;
+    }
+    for (uint8_t i = 0; i < 4; i++) {
+        const uint16_t value = hal.rcin->read(i);
+        if (value < 900 || value > 2100) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void borealis_rc_stop(const char *reason)
+{
+    if (!borealis_rc_active) {
+        return;
+    }
+    // Send a low throttle pulse before removing PWM from the ESC.
+    hal.rcout->write(0, 1000);
+    for (uint8_t i = 1; i < 4; i++) {
+        hal.rcout->write(i, 1500);
+    }
+    borealis_rc_active = false;
+    borealis_rc_stopping = true;
+    borealis_rc_stop_ms = AP_HAL::millis();
+    gcs().send_text(MAV_SEVERITY_WARNING, "BOREALIS TAER STOP: %s", reason);
+}
+
+bool borealis_rc_bench_set(bool enable)
+{
+    if (!enable) {
+        borealis_rc_stop("USB command");
+        return true;
+    }
+    const uint32_t now = AP_HAL::millis();
+    if (borealis_rc_active) {
+        if (now - borealis_rc_last_frame_ms > 100 ||
+            !borealis_rc_inputs_valid()) {
+            return false;
+        }
+        borealis_rc_last_usb_ms = now;
+        return true;
+    }
+    if (!borealis_bench_ready || borealis_rc_has_run || borealis_rc_stopping ||
+        borealis_rc_low_since_ms == 0 ||
+        now - borealis_rc_low_since_ms < 1000 ||
+        now - borealis_rc_last_frame_ms > 100 ||
+        !borealis_rc_inputs_valid()) {
+        return false;
+    }
+    // Keep the safety gate on until all four channels are enabled. This
+    // prevents any previous timer value from reaching the ESC at startup.
+    hal.rcout->force_safety_on();
+    for (uint8_t i = 0; i < 4; i++) {
+        hal.rcout->enable_ch(i);
+    }
+    hal.rcout->force_safety_off();
+    hal.rcout->write(0, 1000);
+    for (uint8_t i = 1; i < 4; i++) {
+        hal.rcout->write(i, 1500);
+    }
+    borealis_rc_started_ms = now;
+    borealis_rc_last_usb_ms = now;
+    borealis_rc_active = true;
+    borealis_rc_has_run = true;
+    gcs().send_text(MAV_SEVERITY_WARNING, "BOREALIS TAER ACTIVE: 90s max");
+    return true;
+}
+
+static void borealis_rc_bench_update(uint32_t now, bool fresh_input)
+{
+    if (fresh_input) {
+        borealis_rc_last_frame_ms = now;
+        if (borealis_rc_inputs_valid() && hal.rcin->read(2) <= 1050) {
+            if (borealis_rc_low_since_ms == 0) {
+                borealis_rc_low_since_ms = now;
+            }
+        } else {
+            borealis_rc_low_since_ms = 0;
+        }
+    }
+
+    if (borealis_rc_active) {
+        if (now - borealis_rc_started_ms >= 90000) {
+            borealis_rc_stop("time limit");
+        } else if (now - borealis_rc_last_usb_ms > 2000) {
+            borealis_rc_stop("USB timeout");
+        } else if (now - borealis_rc_last_frame_ms > 250 ||
+                   !borealis_rc_inputs_valid()) {
+            borealis_rc_stop("receiver lost/invalid");
+        } else {
+            // Output order: THR, AIL, ELE, RUD.
+            // FlySky input order: AIL, ELE, THR, RUD.
+            const uint16_t throttle = constrain_int16(hal.rcin->read(2), 1000, 2000);
+            hal.rcout->write(0, 1000 + (throttle - 1000) * 150 / 1000);
+            const uint8_t input_channel[3] = {0, 1, 3};
+            for (uint8_t i = 0; i < 3; i++) {
+                const int16_t input = constrain_int16(hal.rcin->read(input_channel[i]), 1000, 2000);
+                hal.rcout->write(i + 1, 1500 + (input - 1500) * 2 / 5);
+            }
+        }
+    }
+    if (borealis_rc_stopping && now - borealis_rc_stop_ms >= 1000) {
+        for (uint8_t i = 0; i < 4; i++) {
+            hal.rcout->disable_ch(i);
+        }
+        hal.rcout->force_safety_on();
+        borealis_rc_stopping = false;
+    }
+}
+#endif
 
