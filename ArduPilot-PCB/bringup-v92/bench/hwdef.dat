# BOREALIS v92 bench-only image. Never use for flight.
# Uses the normal v92 bootloader and private board ID 65092.
MCU STM32H7xx STM32H743xx
APJ_BOARD_ID 65092
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16
define HAL_BOREALIS_BENCH_TEST 1

SERIAL_ORDER OTG1 USART1 USART6
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
PB6 USART1_TX USART1
PB7 USART1_RX USART1
PC6 USART6_TX USART6
PC7 USART6_RX USART6
define DEFAULT_SERIAL1_PROTOCOL 0
define DEFAULT_SERIAL2_PROTOCOL 0

PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 BARO_CS CS
PD3 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2
PD4 ACCEL_CS CS
PD5 GYRO_CS CS
SPIDEV ms5611 SPI1 DEVID1 BARO_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmi088_a SPI2 DEVID1 ACCEL_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmi088_g SPI2 DEVID2 GYRO_CS MODE3 1*MHZ 10*MHZ
IMU BMI088 SPI:bmi088_a SPI:bmi088_g ROTATION_NONE
BARO MS5611 SPI:ms5611

I2C_ORDER I2C1
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

PC12 LED OUTPUT LOW GPIO(90)
define AP_NOTIFY_GPIO_LED_1_ENABLED 1
define AP_NOTIFY_GPIO_LED_1_PIN 90
define HAL_GPIO_LED_ON 1
PB15 IMU_LED OUTPUT LOW
PB14 BARO_LED OUTPUT LOW
PB13 GPS_LED OUTPUT LOW
PB12 MAG_LED OUTPUT LOW
PC11 BUZZER_OFF OUTPUT LOW
PC10 ARMING_BUTTON INPUT PULLUP

# Six PWM-capable connector signals. They stay disabled except during a
# bounded MAVLink bench command while the missing IMU holds startup.
PE14 TIM1_CH4 TIM1 PWM(1) GPIO(50) # throttle, J4 pin 1
PE13 TIM1_CH3 TIM1 PWM(2) GPIO(51) # aileron, J4 pin 4
PE11 TIM1_CH2 TIM1 PWM(3) GPIO(52) # elevator, J4 pin 7
PE9  TIM1_CH1 TIM1 PWM(4) GPIO(53) # rudder, J4 pin 10
PD12 TIM4_CH1 TIM4 PWM(5) GPIO(54) # AUX1, J4 pin 13
PD13 TIM4_CH2 TIM4 PWM(6) GPIO(55) # AUX2, J4 pin 16

define HAL_OS_FATFS_IO 0
define HAL_USE_ADC FALSE
